{
  "name": "filebeam",
  "version": "1.0.0",
  "description": "P2P file transfer at WiFi speed",
  "main": "dist/electron/main.js",
  "author": "FileBeam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toun38819-cyber/FileBeam-P2P.git"
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron:build": "tsc -p tsconfig.electron.json --watch",
    "dev:electron": "wait-on tcp:5173 file:dist/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/electron/main.js",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:build\" \"npm:dev:electron\"",
    "build:react": "vite build",
    "build:electron:ts": "tsc -p tsconfig.electron.json",
    "build:electron": "npm run build:electron:ts && electron-builder --config electron-builder.config.js --win",
    "build:server": "python ../local-server/build_server.py",
    "build:all": "npm run build:server && npm run build:react && npm run build:electron",
    "build:portable": "npm run build:electron:ts && electron-builder --config electron-builder.config.js --win portable",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "canvas-confetti": "^1.9.2",
    "dayjs": "^1.11.10",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0",
    "framer-motion": "^10.16.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.294.0",
    "mime-types": "^2.1.35",
    "node-forge": "^1.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "react-webcam": "^7.2.0",
    "react-window": "^1.8.10",
    "recharts": "^2.10.0",
    "wait-on": "^8.0.1",
    "winreg": "^1.2.4",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
